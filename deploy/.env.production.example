# 生产环境变量 —— 复制为 backend/.env 并修改下面两个 SECRET
# 务必修改! 用 `python -c "import secrets; print(secrets.token_hex(32))"` 生成

SECRET_KEY=请改成随机32字节hex
JWT_SECRET_KEY=请改成另一个随机32字节hex

# SQLite 用默认即可,文件在 backend/app.db
# 想换 MySQL 就解开下面这行
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/lianyu?charset=utf8mb4

# 反向代理数(nginx 一层就填 1)
TRUSTED_PROXY_COUNT=1
